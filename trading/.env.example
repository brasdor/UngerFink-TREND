# Binance API — requires Trade + Read Info permissions only
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# FRED (Federal Reserve Economic Data) — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Glassnode — free tier sufficient for BTC on-chain metrics
GLASSNODE_API_KEY=your_glassnode_api_key_here
